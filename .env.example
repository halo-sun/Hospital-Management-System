# ── Database connection ───────────────────────────────────────
# The runtime pool connects as DB_USER (recommended: the
# least-privilege `hms_app` account created by
# database/create_hms_app_user.sql).
DB_HOST=localhost
DB_PORT=3306
DB_USER=hms_app
DB_PASSWORD=
DB_NAME=hospital_db

# ── Elevated schema credentials (optional) ────────────────────
# Used only for one-time schema initialisation (CREATE DATABASE /
# CREATE TABLE).  When omitted, initialisation falls back to DB_USER.
# Leave unset if DB_USER already has DDL rights.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# ── Application ───────────────────────────────────────────────
# SESSION_TIMEOUT=30
# MAX_LOGIN_ATTEMPTS=5
# LOCKOUT_DURATION_MINUTES=15
